{
  "contract_version": 1,
  "strategy": "replace",
  "on_drift": "fail",
  "mappings": [
    { "from": "skills/kb-search", "to": ".zcode/skills/kb-search" },
    { "from": "skills/kb-curate", "to": ".zcode/skills/kb-curate" },
    { "from": "skills/init", "to": ".zcode/skills/init" },
    { "from": "skills/grilling", "to": ".zcode/skills/grilling" },
    { "from": "skills/to-tickets", "to": ".zcode/skills/to-tickets" },
    { "from": "skills/ship", "to": ".zcode/skills/ship" },
    { "from": "skills/testing", "to": ".zcode/skills/testing" },
    { "from": "skills/critic", "to": ".zcode/skills/critic" },
    { "from": "skills/onto-doc", "to": ".zcode/skills/onto-doc" },
    { "from": ".zcode/workflows/onto-doc.dwf.ts", "to": ".zcode/workflows/onto-doc.dwf.ts" }
  ],
  "post_update": [
    {
      "say": "Запусти скилл init (идемпотентен): он создаст управляемый блок в AGENTS.md и допишет строки .gitignore. Конфиг ролей .agents/config.toml init запишет, только если хост отдаст активные модели; иначе назовёт пробел и остановится. Поиск по KB — скилл kb-search; индекс .gitmark/ производный и не коммитится — его строку .gitignore доложит init."
    },
    {
      "run": "python3 .zcode/skills/kb-search/gitmark.py index",
      "if_exists": "docs"
    }
  ]
}
