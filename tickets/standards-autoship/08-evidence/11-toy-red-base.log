$ diff <(git show ae26ce9:README.md | sed -n 4p) <(git show bad5c00c9e56e6386d4dad3ab0dc76233039ec84:README.md | sed -n 4p)
line-4-identical: yes
$ diff <(git show ae26ce9:README.md | sed -n 3p | sed s/tempory/temporary/) <(git show bad5c00c9e56e6386d4dad3ab0dc76233039ec84:README.md | sed -n 3p)
